{
    "name": "xuanpablo/filament-palette",
    "description": "A Spotlight/CMD+K style command palette for quick navigation and actions across Filament panels.",
    "keywords": [
        "xuanpablo",
        "laravel",
        "filament",
        "spotlight",
        "cmd",
        "command",
        "palette",
        "php",
        "filamentphp"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Paul Millar",
            "email": "paul@millar.id",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Xuanpablo\\FilamentPalette\\": "src"
        }
    },
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.19",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Xuanpablo\\FilamentPalette\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xuanpablo\\FilamentPalette\\FilamentPaletteServiceProvider"
            ]
        }
    }
}
